---
type Props = {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: "left" | "center";
  as?: "h2" | "h3";
  size?: "md" | "lg";
};

const { eyebrow, title, lede, align = "left", as = "h2", size = "md" } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
const titleClass =
  size === "lg" ? "text-display-md md:text-display-lg" : "text-2xl md:text-3xl";
const Tag = as;
---

<header class={`max-w-[640px] ${alignClass}`}>
  {eyebrow && (
    <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-accent mb-3">
      {eyebrow}
    </p>
  )}
  <Tag class={`${titleClass} font-semibold tracking-tight text-text`}>
    {title}
  </Tag>
  {lede && (
    <p class="mt-3 text-base text-text-muted leading-relaxed">
      {lede}
    </p>
  )}
</header>
